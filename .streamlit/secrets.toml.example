# Copy to .streamlit/secrets.toml on your laptop (never commit it).
# On Streamlit Cloud, paste these lines into the app's Settings → Secrets.
GOOGLE_API_KEY = ""

# Optional: save every order to the "TeaTrail Orders" Google Sheet
# (see google-apps-script/orders_webhook.gs for the one-time set-up).
# ORDERS_WEBHOOK_URL = "https://script.google.com/macros/s/…/exec"
# ORDERS_WEBHOOK_SECRET = "a long random value, the same one you put in the Apps Script"

# Optional: message limits that protect your Gemini quota (defaults shown).
# MAX_MESSAGES_PER_VISITOR = 30   # per visitor, per day
# MAX_MESSAGES_PER_DAY = 500      # whole site, per day
